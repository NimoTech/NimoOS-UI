+<template>
+  <button class="dock-app" :data-app="appKey" @click="onClick">
+    <span class="dock-ic" :class="meta?.icon ? 'has-img' : meta?.cls">
+      <img v-if="meta?.icon" :src="meta.icon" alt="" loading="lazy" />
