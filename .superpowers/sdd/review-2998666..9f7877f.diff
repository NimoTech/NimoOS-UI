+    ...mod,
+    service: { ai: { attachmentRawUrl: vi.fn((sid: string, id: string) => `/v1/ai/attachments/${sid}/${id}/raw?token=t`) } },
+  }
+})
+import { service } from '@nimotech/nimoos-service'
