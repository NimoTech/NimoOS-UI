+  } catch {
+    toast.show(t('aiCfgToggleFailed'), 1500, 'danger')
+  }
+}
+
+/** Vue2 :175-182 —— catch 优先展示 e.message,不带 message 才用兜底文案。 */
+async function onSave() {
+  try {
