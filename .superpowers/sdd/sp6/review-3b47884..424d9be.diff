+    const members = [
+      { path: '/dev/sdb', state: 'active sync set-B', number: 1 },
+      { path: '/dev/sda', state: 'active sync set-A', number: 0 },
+      { path: '/dev/sdd', state: 'active sync set-B', number: 3 },
