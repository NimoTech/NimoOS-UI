+async function removeSelected(): Promise<void> {
+  const ids = selectedIds.value.slice()
+  if (!ids.length) return
+  try {
+    await store.exclude(momentId.value, ids)
+    toast.show(t('photosMoRemovedN', { n: ids.length }))
