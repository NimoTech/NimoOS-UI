+      <header class="rt-head">
+        <span>{{ t('aiResPending') }} <span class="rt-count">({{ t('aiResFilesInTurns', { files: totalChangedFiles, turns: stagedChanges.length, s: pluralWord(stagedChanges.length) }) }})</span></span>
