+  openUploadDB, putQueueItem, getAllQueueItems, removeQueueItem,
+  putBlob, getBlob, removeBlob, removeItemAndBlob, pruneOld, _resetForTest,
+} from './idb'
+
+beforeEach(() => {
+  // 每例一套全新 IndexedDB,避免跨例污染
+  ;(globalThis as any).indexedDB = new IDBFactory()
+  _resetForTest()
