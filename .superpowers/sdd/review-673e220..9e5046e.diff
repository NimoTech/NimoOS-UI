+        </label>
+        <div class="uc-footer">
+          <AlertDialogCancel class="uc-btn">{{ t('appsCancel') }}</AlertDialogCancel>
+          <AlertDialogAction class="uc-btn danger" @click="emit('confirm', delData)">{{ t('appsUninstall') }}</AlertDialogAction>
