+      <span v-if="decision === 'allow'">{{ t('aiMcpRegistered', { name }) }}</span>
+      <span v-else>{{ t('aiMcpRegDeclined') }}</span>
+      <button class="undo" @click="decision = null">{{ t('aiChange') }}</button>
+    </div>
+    <template v-else>
