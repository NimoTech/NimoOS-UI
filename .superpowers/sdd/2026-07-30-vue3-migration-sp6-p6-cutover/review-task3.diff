diff --git a/src/components/filebrowser/components/__tests__/MountActionButton.spec.js b/src/components/filebrowser/components/__tests__/MountActionButton.spec.js
new file mode 100644
index 00000000..3c5063c0
--- /dev/null
+++ b/src/components/filebrowser/components/__tests__/MountActionButton.spec.js
@@ -0,0 +1,52 @@
+import { describe, it, expect, vi, beforeEach, afterEach } from 'vitest'
+
+// 说明:MountActionButton.vue 顶部静态 import 了 StorageManagerPanel.vue / NewNetworkStorage.vue /
+// GoogleDriveAuthModal.vue,其子依赖链最终 require() 一个 wallpaper 图片资源,Vite/Vitest 默认
+// resolver 无法处理,哪怕只是 `import MountActionButton from '.../MountActionButton.vue'` 这一行
+// 本身也会在模块加载期崩溃(与本改动无关)。用最小 stub 顶替,阻止 Vite 去 transform 真实源码,
+// 不代表要测它们的行为。
+vi.mock('@/components/Storage/StorageManagerPanel.vue', () => ({ default: { name: 'StorageManagerPanelStub', render: () => null } }))
+vi.mock('@/components/filebrowser/modals/NewNetworkStorage.vue', () => ({ default: { name: 'NewNetworkStorageStub', render: () => null } }))
+vi.mock('@/components/filebrowser/modals/GoogleDriveAuthModal.vue', () => ({ default: { name: 'GoogleDriveAuthModalStub', render: () => null } }))
+
+import MountActionButton from '@/components/filebrowser/components/MountActionButton.vue'
+
+// 说明:MountActionButton.vue 的 created() 打 $api.driver.getDriverList,挂载需无关 mock。
+// 本用例测 showDiskManagement 里的 cutover 分支,故在桩 this 上直调该方法。
+// 该组件原本没有 widget_storagemanager 埋点,本期也不加。
+function stubThis() {
+  return { $buefy: { modal: { open: vi.fn() } } }
+}
+
+let savedLocation
+let hrefs
+beforeEach(() => {
+  hrefs = []
+  savedLocation = window.location
+  Object.defineProperty(window, 'location', {
+    configurable: true,
+    value: { set href(v) { hrefs.push(v) }, get href() { return '' } },
+  })
+  localStorage.removeItem('strangler:disabled:/storage')
+})
+afterEach(() => {
+  Object.defineProperty(window, 'location', { configurable: true, value: savedLocation })
+  localStorage.removeItem('strangler:disabled:/storage')
+})
+
+describe('文件区挂载按钮存储入口 cutover(SP6-P6)', () => {
+  it('未回退时整页跳 /app/#/storage,不开老弹窗', () => {
+    const vm = stubThis()
+    MountActionButton.methods.showDiskManagement.call(vm)
+    expect(hrefs).toEqual(['/app/#/storage'])
+    expect(vm.$buefy.modal.open).not.toHaveBeenCalled()
+  })
+
+  it('回退 flag == "1" 时开老弹窗,不跳转', () => {
+    localStorage.setItem('strangler:disabled:/storage', '1')
+    const vm = stubThis()
+    MountActionButton.methods.showDiskManagement.call(vm)
+    expect(hrefs).toEqual([])
+    expect(vm.$buefy.modal.open).toHaveBeenCalledTimes(1)
+  })
+})
