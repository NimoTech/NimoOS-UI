# Claude Code local state (isolated worktrees, session config) — not committed
.claude/
# .superpowers/ IS committed — the ledgers are the only decision record per sprint. SP7 once
# lost the whole directory with no git recovery, and SP9-P7 found the P5/P6 ledgers only
# existed in gitignore. Rules live in .superpowers/.gitignore:
# ledgers (.md) and self-check screenshots (.png) go in; review diffs / backups / snapshot-env machine artifacts stay out.

# Env vars / local config (may contain secrets, never committed)
.env
.env.*
*.local

# Test coverage, incremental type-check cache, logs
coverage/
*.tsbuildinfo
pnpm-debug.log*
npm-debug.log*

# System / editor junk
.DS_Store
.idea/

# Time-machine acceptance test bench (T12): fake backend + dedicated vite config, local acceptance only, not versioned
scripts/tmlab/
vite.config.tmlab.ts

