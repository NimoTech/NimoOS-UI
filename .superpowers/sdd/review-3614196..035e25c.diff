+const messages = {
+  zh_cn: {
+    aiThinkingLabel: '思考',
+    aiThinkingIntensity: '强度',
+    aiThinkingLow: '低',
+    aiThinkingMedium: '中',
+    aiThinkingHigh: '高',
+    aiThinkingMax: '极高',
+    aiThinkingUnsupported: '该模型不支持思考',
+    aiThinkingDeepseekNote: 'DeepSeek 上「低/中」以及「高/极高」行为分别相同',
+  },
+}
+const i18n = createI18n({ legacy: false, locale: 'zh_cn', messages })
