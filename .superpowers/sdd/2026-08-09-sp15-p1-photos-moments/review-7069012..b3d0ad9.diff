+    svc.photos.listMoments.mockResolvedValueOnce([RAW])
+    await w.find('[data-test="mo-load-failed-retry"]').trigger('click')
+    await flushPromises()
+
+    expect(w.find('[data-test="mo-load-failed"]').exists()).toBe(false)
+    expect(w.text()).toContain('Bozeman')
+    err.mockRestore()
+  })
 })
