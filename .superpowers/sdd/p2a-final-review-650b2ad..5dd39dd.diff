+.set-rail-back { width: 30px; height: 30px; border-radius: 9px; display: grid; place-items: center; color: var(--text-secondary); background: var(--bg-elevated); border: 1px solid var(--line-faint); transition: all 120ms ease; text-decoration: none; flex-shrink: 0; cursor: pointer; }
+.set-rail-back:hover { background: var(--bg-chip); color: var(--text-primary); }
+.set-rail-title { font-size: 15px; font-weight: 650; letter-spacing: -0.015em; }
+.set-rail-sub { font-size: 11px; color: var(--text-tertiary); margin-top: -2px; }
+.set-nav { flex: 1; overflow-y: auto; padding: 10px 8px 14px; display: flex; flex-direction: column; gap: 1px; min-height: 0; }
+.set-nav-item { display: flex; align-items: center; gap: 11px; padding: 8px 11px; border-radius: var(--r-sm); font-size: 13px; font-weight: 500; color: var(--text-secondary); cursor: pointer; transition: background 100ms ease, color 100ms ease; text-decoration: none; position: relative; }
+.set-nav-item:hover { background: var(--bg-chip); color: var(--text-primary); }
