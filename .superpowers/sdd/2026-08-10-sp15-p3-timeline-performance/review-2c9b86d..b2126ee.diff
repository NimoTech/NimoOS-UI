+    expect(svc.photos.getTimelineBuckets).toHaveBeenCalledTimes(1)
+    vi.advanceTimersByTime(3001)
+    svc.photos.getStatus.mockResolvedValueOnce({ indexed: 3 })
+    await s.fetchIndexStatus()
