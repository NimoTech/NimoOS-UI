+    await w.find('.sidebar-foot .icon-btn').trigger('click')
+    expect(showSpy).toHaveBeenCalledWith('对话发送将在下一期开启')
+    expect(push).not.toHaveBeenCalled()
+    w.unmount()
+  })
+})
