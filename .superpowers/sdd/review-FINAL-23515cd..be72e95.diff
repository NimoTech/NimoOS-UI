+  const w = mount(NotesView, { global: { plugins: [router, i18n] }, attachTo: document.body } as never)
+  mountedWrappers.push(w)
+  await flushPromises()
+  await nextTick()
+  return { w, router }
+}
+
+const flush = async () => {
+  await flushPromises()
+  await nextTick()
+}
