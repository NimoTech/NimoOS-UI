+    &[data-state="running"] { background: rgba(0, 122, 255, 0.22); color: #6FB6FF; }
+    &[data-state="error"] { background: rgba(255, 59, 48, 0.22); color: #FF8579; }
+    &[data-state="warn"], &[data-state="approval"] { background: rgba(255, 149, 0, 0.22); color: #FFB958; }
+
+    .dots span { background: currentColor; width: 4px; height: 4px; }
+  }
+
+  .term-meta {
+    padding: 7px 14px;
+    display: flex; align-items: center; gap: 10px;
+    font-family: var(--font-sans); font-size: 11px;
+    color: rgba(255, 255, 255, 0.45);
+    border-bottom: 1px solid rgba(255, 255, 255, 0.05);
+    background: #14171C;
+  }
+  .term-meta-item { display: flex; align-items: center; gap: 5px; }
+  .term-meta-item code {
+    font-family: var(--font-mono);
+    color: rgba(255, 255, 255, 0.7);
+    background: rgba(255, 255, 255, 0.05);
+    padding: 1px 6px; border-radius: 4px;
+    font-size: 11px;
+  }
+  .term-meta-sep { opacity: 0.4; }
+  .term-meta-spacer { flex: 1; }
+  .term-meta-toggle {
+    background: transparent;
+    border: 0;
+    color: rgba(255, 255, 255, 0.5);
+    font-family: var(--font-sans);
+    font-size: 11px;
+    cursor: pointer;
+    padding: 0;
+    &:hover { color: rgba(255, 255, 255, 0.8); }
+  }
+
+  .term-cmd {
+    padding: 10px 14px 8px;
+    font-size: 12.5px;
+    display: flex; gap: 8px;
+    border-bottom: 1px solid rgba(255, 255, 255, 0.05);
+    background: #14171C;
+  }
+  .term-prompt {
+    color: #5BD876;
+    flex-shrink: 0;
+    user-select: none;
+    font-weight: 600;
+  }
+  .term-cmd-text {
+    color: rgba(255, 255, 255, 0.92);
+    white-space: pre-wrap;
+    word-break: break-all;
+    line-height: 1.55;
+    .flag { color: #FFB958; }
+    .str { color: #C792EA; }
+  }
+
+  .term-body {
+    padding: 10px 14px 12px;
+    font-size: 12px;
+    line-height: 1.55;
+    color: rgba(255, 255, 255, 0.82);
+    max-height: 260px;
+    overflow-y: auto;
+    white-space: pre-wrap;
+    word-break: break-word;
+
+    &::-webkit-scrollbar { width: 8px; }
+    &::-webkit-scrollbar-thumb {
+      background: rgba(255, 255, 255, 0.12);
+      border-radius: 999px;
+    }
+  }
+  .term-line {
+    display: block;
+    &[data-stream="stderr"] { color: #FF8579; }
+    &[data-stream="info"] { color: #6FB6FF; }
+    &[data-stream="dim"] { color: rgba(255, 255, 255, 0.45); }
+  }
+  .term-cursor {
+    display: inline-block;
+    width: 7px; height: 13px; vertical-align: -2px;
+    background: rgba(255, 255, 255, 0.85);
+    margin-left: 1px;
+    animation: agent-blink 1s steps(2) infinite;
+  }
+
+  .term-foot {
+    padding: 8px 12px;
+    display: flex; align-items: center; gap: 8px;
+    background: #14171C;
+    border-top: 1px solid rgba(255, 255, 255, 0.05);
+    font-family: var(--font-sans); font-size: 11px;
+    color: rgba(255, 255, 255, 0.5);
+
+    button {
+      font-family: var(--font-sans); font-size: 11px;
+      color: rgba(255, 255, 255, 0.7);
+      padding: 4px 9px; border-radius: 6px;
+      background: rgba(255, 255, 255, 0.06);
+      border: 1px solid rgba(255, 255, 255, 0.08);
+      display: inline-flex; align-items: center; gap: 5px;
+      cursor: pointer;
+      transition: background 120ms ease;
+      &:hover { background: rgba(255, 255, 255, 0.12); }
+    }
+    .right { margin-left: auto; display: flex; gap: 6px; align-items: center; }
+    .term-foot-sep { opacity: 0.4; }
+    .term-foot-ok { color: #5BD876; }
+    .term-foot-fail { color: #FF8579; }
+  }
+
+  .term-approval {
+    background: linear-gradient(90deg, rgba(255, 149, 0, 0.12), rgba(255, 149, 0, 0.06));
+    border-top: 1px solid rgba(255, 149, 0, 0.25);
+    padding: 10px 12px;
+    display: flex; align-items: center; gap: 10px;
+    font-family: var(--font-sans); font-size: 12px;
+    color: rgba(255, 255, 255, 0.85);
+  }
+  .term-approval-icon {
+    width: 22px; height: 22px; border-radius: 7px;
+    background: rgba(255, 149, 0, 0.25);
+    color: #FFB958;
+    display: grid; place-items: center;
+    flex-shrink: 0;
+  }
+  .term-approval-text { flex: 1; min-width: 0; }
+  .term-approval-title { font-weight: 500; }
+  .term-approval-reason {
+    font-size: 11px;
+    color: rgba(255, 255, 255, 0.55);
+    margin-top: 2px;
+  }
+  .term-approval button {
+    padding: 5px 11px; border-radius: 7px;
+    font-size: 12px; font-weight: 500;
+    border: 0; cursor: pointer;
+    &.approve { background: #FF9500; color: #1A1A1A; }
+    &.deny {
+      background: rgba(255, 255, 255, 0.08);
+      color: rgba(255, 255, 255, 0.85);
+      border: 1px solid rgba(255, 255, 255, 0.12);
+    }
+  }
+}
+
+// ===== Keyframe animations (prefixed with "agent-" to avoid global collisions) =====
+
+@keyframes agent-pulse {
+  0%, 100% { box-shadow: 0 0 0 0 rgba(59, 111, 212, 0.5); }
+  50% { box-shadow: 0 0 0 6px rgba(59, 111, 212, 0); }
+}
+
+@keyframes agent-float {
+  0%, 100% { transform: translateY(0); }
+  50% { transform: translateY(-6px); }
+}
+
+@keyframes agent-pulse-orb {
+  0%, 100% { opacity: 0.85; transform: scale(1); }
+  50% { opacity: 1; transform: scale(1.08); }
+}
+
+@keyframes agent-spin-slow {
+  to { transform: rotate(360deg); }
+}
+
+@keyframes agent-blink {
+  50% { opacity: 0; }
+}
+
+@keyframes agent-bounce {
+  0%, 60%, 100% { transform: translateY(0); opacity: 0.4; }
+  30% { transform: translateY(-3px); opacity: 1; }
+}
+
+@keyframes agent-shimmer {
+  0% { background-position: 200% 0; }
+  100% { background-position: -200% 0; }
+}
+
+@keyframes agent-wave {
+  0%, 100% { height: 30%; }
+  50% { height: 90%; }
+}
