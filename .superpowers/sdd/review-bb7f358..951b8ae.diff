 export function clampWidgetDecl(w?: number, h?: number): [number, number] {
   const cw = !w || w < 2 ? 2 : Math.min(4, w)
   const ch = !h || h < 1 ? 2 : Math.min(4, h)
   return [!w || w <= 0 ? 2 : cw, !h || h <= 0 ? 2 : ch]
 }
 
