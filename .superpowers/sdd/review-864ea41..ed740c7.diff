+.kind-app .app-ic,
+.kind-folder .folder-tile,
+.kind-folder .folder-ic,
+.kind-photo .photo-thumb { transition: transform .18s var(--ease, ease), box-shadow .18s var(--ease, ease), filter .18s var(--ease, ease); }
+/* 悬停时将当前项提到邻居之上，防止放大后被相邻格子裁剪 */
+/* NOTE: In New-UI, .kind-* and .editing are BOTH on .grid-item root (no parent .grid.editing wrapper),
+   so the mapping is .grid-item:not(.editing).kind-*:hover (compound, not descendant). */
+.grid-item:not(.editing).kind-app:hover,
+.grid-item:not(.editing).kind-folder:hover,
+.grid-item:not(.editing).kind-photo:hover { z-index: 6; }
+/* 悬停放大：抬升 + accent 内发光 + 底部投影 */
+.grid-item:not(.editing).kind-app:hover .app-ic,
+.grid-item:not(.editing).kind-folder:hover .folder-tile,
+.grid-item:not(.editing).kind-folder:hover .folder-ic,
+.grid-item:not(.editing).kind-photo:hover .photo-thumb {
+  transform: translateY(-7px) scale(1.2);
+  box-shadow:
+    inset 0 1px 0 rgba(255, 255, 255, .6),
+    inset 0 0 22px -4px var(--accent),
+    0 26px 48px -10px rgba(6, 10, 26, .66);
+  filter: brightness(1.1);
+}
+/* NOTE: .tile-2up is NOT emitted by GridItem in New-UI (item.w/h are available but no class is set).
+   Deferred: add .tile-2up emission to GridItem when w>=2 && h>=2 for gentler var(--card-hover) scale.
+   For now, scale(1.2) applies uniformly to all tile sizes. */
+/* 按压下沉 */
+.grid-item:not(.editing).kind-app:active .app-ic,
+.grid-item:not(.editing).kind-folder:active .folder-tile,
+.grid-item:not(.editing).kind-photo:active .photo-thumb { transform: scale(.95); transition: transform .1s var(--ease, ease); }
