+.rdb-seg-btn {
+  border: 0; background: transparent; padding: 5px 12px; border-radius: 999px;
+  font-size: 12px; color: var(--fg-muted); cursor: pointer;
+}
+.rdb-seg-btn--on { background: var(--card-bg); color: var(--fg); box-shadow: var(--card-shadow, none); }
+
