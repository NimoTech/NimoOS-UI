+
+  it('附带文件为空数组时展示空态文案「没有附带文件」', () => {
+    const w = mountDetail(makeSkill({ files: [] }))
+    const rows = w.findAll('.sk-file-row')
+    expect(rows).toHaveLength(1)
+    expect(rows[0].find('.name').text()).toBe('没有附带文件')
