+    <template #footer>
+      <button class="rdd-cancel" type="button" :disabled="busy" @click="emit('update:open', false)">{{ t('storageCancel') }}</button>
+      <button class="rdd-ok danger" type="button" :disabled="confirmText !== name || busy" @click="emit('confirm')">
