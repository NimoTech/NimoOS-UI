+.hf-meta { color: var(--text-tertiary); font-size: 11px; white-space: nowrap; }
+.hf-files-area { padding: 0 18px 14px; }
+.hf-files-header { display: flex; align-items: center; gap: 10px; margin-bottom: 8px; font-size: 12px; color: var(--text-secondary); }
+.hf-files-header > :first-child { flex: 1; font-family: var(--font-mono); word-break: break-all; }
+.hf-file { display: flex; align-items: center; gap: 10px; padding: 8px 12px; border-bottom: 1px solid var(--line-faint); font-family: var(--font-mono); font-size: 12px; }
+.hf-file:last-child { border-bottom: 0; }
+.hf-file > :first-child { flex: 1; word-break: break-all; }
+
+/* loading/empty inside cards */
+.set-note { padding: 22px 18px; font-size: 13px; color: var(--text-tertiary); text-align: center; }
+
+/* ---------- Provider inline form ---------- */
+.set-form { padding: 16px 18px; }
+.set-form .preset-row { display: flex; gap: 6px; flex-wrap: wrap; margin-bottom: 16px; }
+.set-form .preset-chip { padding: 5px 12px; border-radius: 999px; background: var(--bg-chip); border: 0; font-size: 12px; color: var(--text-secondary); cursor: pointer; transition: all 120ms ease; }
+.set-form .preset-chip:hover { background: var(--accent-soft); color: var(--accent); }
+.set-form .field { margin-bottom: 14px; }
+.set-form .field label { display: block; font-size: 12px; font-weight: 550; color: var(--text-secondary); margin-bottom: 5px; }
+.set-form .field .help { font-size: 11px; color: var(--text-tertiary); margin-top: 5px; }
+.set-form .radio-row { display: flex; gap: 16px; }
+.set-form .radio-option { display: flex; align-items: center; gap: 6px; font-size: 13px; cursor: pointer; }
+
+/* ---------- Provider expandable model panel ---------- */
+.pm-panel { padding: 6px 16px 14px; background: var(--bg-sunken); }
+.pm-head { display: flex; align-items: center; gap: 8px; padding: 8px 2px; font-size: 12px; color: var(--text-secondary); }
+.pm-head .sp { flex: 1; }
+.pm-list { list-style: none; margin: 0; padding: 0; }
+.pm-item { display: flex; align-items: center; gap: 8px; padding: 8px 6px; border-top: 1px solid var(--line-faint); font-size: 13px; }
+.pm-item .nm { flex: 1; font-family: var(--font-mono); font-size: 12px; word-break: break-all; }
+.pm-item .src { font-size: 10.5px; color: var(--text-tertiary); background: var(--bg-chip); padding: 1px 7px; border-radius: 999px; }
+
+/* ===== Scoped overrides — keep confined to .set-app ===== */
+.set-app {
+  button { background: transparent; border: 0; color: inherit; cursor: pointer; font: inherit; }
+
+  .icon-btn {
+    width: 32px; height: 32px;
+    display: inline-grid; place-items: center;
+    border-radius: 9px;
+    color: var(--text-secondary);
+    transition: background 100ms ease, color 100ms ease;
+    &:hover { background: var(--bg-chip); color: var(--text-primary); }
+  }
+
+  // Vue2 原注释说这是为了压制 Bulma 全局 `code` 样式(白底红字,暗色下露白框)。
+  // 本仓没有 Bulma,那个动机不存在;规则仍保留,因为它给 <code> 一个与设计
+  // 体系一致的外观,删掉会让将来任何 <code> 用浏览器默认样式裸奔。
+  code { background: var(--bg-chip); color: var(--text-primary); font-family: var(--font-mono); border-radius: 5px; padding: 1px 6px; }
+
+  // Raw inputs that don't carry a .set-* class still need theming, or the
+  // browser-default white background shows through in dark mode.
+  input[type="text"]:not(.set-input), input[type="number"]:not(.set-input),
+  input[type="password"]:not(.set-input), input[type="search"]:not(.set-input),
+  input[type="url"]:not(.set-input), input:not([type]):not(.set-input),
+  textarea:not(.set-input) {
+    background: var(--bg-elevated); color: var(--text-primary);
+    border: 1px solid var(--line); border-radius: var(--r-sm);
+    padding: 6px 10px; font-size: 13px; outline: none;
+  }
+}
+
+/* responsive */
+@media (max-width: 720px) {
+  .set-app { grid-template-columns: 60px 1fr; }
+  .set-rail-title, .set-rail-sub, .set-nav-item span:not(.set-nav-badge), .set-foot .txt { display: none; }
+  .set-nav-item { justify-content: center; padding: 9px; }
+  .set-nav-item .set-nav-badge { display: none; }
+  /* Icon-only rail: drop group headers, always show every item. */
+  .set-nav-grouphead { display: none; }
+  .set-nav-group + .set-nav-group { margin-top: 2px; }
+  .set-nav-groupbody { display: flex !important; }
+  .set-status { display: none; }
+}
