   if (!dragging) {
     if (Math.abs(e.clientX - downX) < DRAG_THRESHOLD && Math.abs(e.clientY - downY) < DRAG_THRESHOLD) return
     dragging = true // 越过阈值 → 正式起框
     marquee.value = { x1: downX, y1: downY, x2: downX, y2: downY }
     window.getSelection()?.removeAllRanges()
