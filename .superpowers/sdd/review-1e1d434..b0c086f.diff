+    s.ingest({ cpu: null, mem: null, disk: null, gpu: null, net: [{ name: 'eth0', state: 'up', bytesSent: 100, bytesRecv: 200, time: 2 }] as any, usb: null } as Utilization)
+    const h = s.netHist['eth0']
