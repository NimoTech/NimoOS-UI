+
+describe('composeWebUrl', () => {
+  it('port_map + index 拼完整地址,hostname 缺省用当前主机', () => {
+    expect(composeWebUrl({ scheme: 'http', hostname: null, port_map: '15006', index: '/' }, 'nas.local'))
+      .toBe('http://nas.local:15006/')
