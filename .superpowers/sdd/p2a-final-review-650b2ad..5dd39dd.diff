+          </div>
+          <div class="dl-filename">{{ filename }}</div>
+          <div class="dl-prog-track">
+            <div
+              class="dl-prog-fill"
+              :style="{ width: job.total > 0 ? ((job.completed / job.total) * 100).toFixed(1) + '%' : '0%' }"
