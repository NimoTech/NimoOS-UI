+  tagline: { en_us: 'The personal Media System', zh_cn: '个人媒体系统' },
+  icon: 'https://cdn/icon.png',
+  category: 'Media',
+} as never
+
+describe('mapStoreApp', () => {
+  it('按 lang 归一化,title 缺 zh_cn 落 en_us,icon/category 透传', () => {
