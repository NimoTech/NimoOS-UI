   id: string
   title: string
   tagline: string
   icon: string
   thumbnail: string
   category: string
+  architectures: string[]
+  tips: unknown
 }
 
 export function mapStoreApp(id: string, raw: StoreAppInfo, lang: string): StoreApp {
   return {
     id,
     title: resolveAppText(raw.title, lang, id),
     tagline: resolveAppText(raw.tagline, lang, ''),
