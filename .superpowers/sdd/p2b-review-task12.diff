+  }
+}
+
+function confirmDeleteBot(inst: ChannelInstance) {
+  pendingBotId.value = inst.id
+  confirmDeleteBotOpen.value = true
+}
+
+async function onConfirmDeleteBot() {
+  const id = pendingBotId.value
+  if (id == null) return
