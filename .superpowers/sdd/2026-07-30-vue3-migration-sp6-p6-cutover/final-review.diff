diff --git a/src/router/strangler.js b/src/router/strangler.js
index c8b746dd..b034f9a6 100644
--- a/src/router/strangler.js
+++ b/src/router/strangler.js
@@ -38,10 +38,31 @@ function matches(entry, path) {
 export function resolveTarget(fullPath, storage) {
 	const qi = fullPath.indexOf('?')
 	const path = qi === -1 ? fullPath : fullPath.slice(0, qi)
 	const query = qi === -1 ? '' : fullPath.slice(qi)
 	const entry = migratedRoutes.find((e) => matches(e, path))
 	if (!entry) return null
 	if (!isEnabled(entry.from, storage)) return null
 	if (!entry.prefix) return entry.to
 	return entry.to + path.slice(entry.from.length) + query
 }
+
+/**
+ * 无路由绞杀点:Vue2 侧是模态弹窗、没有路由,进不了 migratedRoutes(全局守卫拦不到),
+ * 由入口调用处自己判定。SP6-P6 存储区是第一条;SP7/SP8 若也有模态型入口,在此续行,
+ * 不要回到「每个调用处各写一遍 localStorage 判断」。
+ * flag 命名与 migratedRoutes 共用:localStorage['strangler:disabled:<from>'] === '1' 即回退。
+ */
+export const migratedEntries = [
+	{ from: '/storage', to: '/app/#/storage', enabled: true }, // SP6-P6:三处存储弹窗入口
+]
+
+/**
+ * 命中且未回退 → 返回目标 URL(调用处整页跳转);未登记 / 已禁用 / 已回退 → null(调用处走原弹窗)。
+ */
+export function resolveEntryTarget(from, storage) {
+	const entry = migratedEntries.find((e) => e.from === from)
+	if (!entry || !entry.enabled) return null
+	const ls = resolveStorage(storage)
+	if (ls && ls.getItem(flagKey(from)) === '1') return null
+	return entry.to
+}
