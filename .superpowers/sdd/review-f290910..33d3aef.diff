+    expect(dashArrayFor(110)).toBe(`${RING_C.toFixed(2)} ${RING_C.toFixed(2)}`)
+  })
+  it('0 → 零长弧', () => {
+    expect(dashArrayFor(0)).toBe(`0.00 ${RING_C.toFixed(2)}`)
+  })
+})
