+    expect(w.find('.set-chevron').exists()).toBe(false)
+  })
+
+  it('clickable 时根元素是 button 并带 chevron,点击 emit click', async () => {
+    const w = mount(SettingsRow, { props: { label: 'a', clickable: true } })
