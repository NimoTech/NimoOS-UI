+describe('command 保守写回(P6 修复:string 不再塌成单元素 exec 数组)', () => {
+  it('string command 解析时标记 commandWasString', () => {
+    const m = parseSettings('services:\n  app:\n    image: redis\n    command: redis-server --appendonly yes\n', 'zh_cn')
