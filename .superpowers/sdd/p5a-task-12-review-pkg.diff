+    expect(glueIds[2].attributes('style')).toContain('--g: var(--ly-note)')
+  })
+})
+
+describe('DashboardView — 数值与文案', () => {
+  it('三层卡分别显示根数 / 文档数 / 笔记数,数字带千分位', async () => {
