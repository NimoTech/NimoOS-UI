++        <span v-if="moment.addedThisWeek > 0" class="mo-week-badge">{{ t('photosMoAddedThisWeek', { n: moment.addedThisWeek }) }}</span>
++        <span style="flex:1" />
++        <span v-if="moment.subtitle" class="mo-span-mini">{{ moment.subtitle }}</span>
++      </div>
++    </div>
++  </div>
++</template>
