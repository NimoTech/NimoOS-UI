+      getAppVersion: async (p?: unknown) => { state.versionCalls.push(p); return state.os },
+      updateOs: async () => { state.updateOsCalls++; if (state.updateOsFail) throw new Error('boom') },
+      updateApp: async () => { state.updateOsCalls++ },
