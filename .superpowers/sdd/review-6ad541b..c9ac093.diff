+const { t } = useI18n()
+const utilStore = useUtilization()
+const tiles = computed(() => systemTiles(utilStore.data))
+</script>
+
+<template>
+  <div>
+    <div style="font-size: 12px; color: var(--text-tertiary); margin-bottom: 10px;
