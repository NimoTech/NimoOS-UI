+
+  it('附带文件为 null(后端 nil slice 序列化坑)时同样展示空态,不抛错', () => {
+    const w = mountDetail(makeSkill({ files: null as unknown as Skill['files'] }))
+    const rows = w.findAll('.sk-file-row')
