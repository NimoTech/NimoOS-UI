+describe('dashArrayFor', () => {
+  const fmt = (p: number) => ((p / 100) * (2 * Math.PI * 15.5)).toFixed(2)
+  it('15 → "<filled> <circumference>"', () => {
+    expect(dashArrayFor(15)).toBe(`${fmt(15)} ${RING_C.toFixed(2)}`)
+  })
