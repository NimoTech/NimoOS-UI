+/* NimoOS Widget Kit v1 — 第三方桌面小组件设计套件
+ * 用法:桌面以 iframe 打开你的 widget 页,并附 ?theme=dark|light&lang=zh_cn&home=<桌面origin>
+ *   <script>
+ *     const q = new URLSearchParams(location.search)
+ *     document.documentElement.dataset.theme = q.get('theme') || 'dark'
+ *     const l = document.createElement('link'); l.rel = 'stylesheet'
+ *     l.href = (q.get('home') || '') + '/app/widget-kit.css'; document.head.appendChild(l)
+ *   </script>
+ * 也可把本文件拷进你的应用(vendoring),离线可用。
+ * token 与 NimoOS 桌面 theme.css 对齐;组件类以 .nk- 前缀。 */
+
+:root {
+  --nk-font: -apple-system, BlinkMacSystemFont, "Segoe UI", system-ui, "PingFang SC", "Microsoft YaHei", "Noto Sans CJK SC", sans-serif;
+  --nk-num-font: system-ui, -apple-system, "Segoe UI", sans-serif;
+  --nk-radius: 18px;
+  --nk-ease: cubic-bezier(0.16, 1, 0.3, 1);
+  /* dark(桌面 blue 主题)为默认 */
+  --nk-bg: transparent;              /* 卡片壳由桌面画,widget 页保持透明底 */
+  --nk-fg: #ffffff;
+  --nk-muted: rgba(255, 255, 255, 0.74);
+  --nk-faint: rgba(255, 255, 255, 0.52);
+  --nk-accent: #8ab4ff;
+  --nk-good: #5fe3b0;
+  --nk-bad: #ff8a80;
+  --nk-divider: rgba(255, 255, 255, 0.1);
+  --nk-track: rgba(255, 255, 255, 0.14);
+}
+:root[data-theme="light"] {
+  --nk-fg: #1b2540;
+  --nk-muted: rgba(27, 37, 64, 0.72);
+  --nk-faint: rgba(27, 37, 64, 0.5);
+  --nk-accent: #3d6fe0;
+  --nk-good: #0e9e6e;
+  --nk-bad: #d64545;
+  --nk-divider: rgba(27, 37, 64, 0.12);
+  --nk-track: rgba(27, 37, 64, 0.14);
+}
+
+html, body { margin: 0; padding: 0; background: var(--nk-bg); }
+body {
+  font-family: var(--nk-font);
+  color: var(--nk-fg);
+  font-size: 14px;
+  line-height: 1.45;
+  -webkit-font-smoothing: antialiased;
+  padding: 4px 2px;
+  box-sizing: border-box;
+}
+*, *::before, *::after { box-sizing: inherit; }
+
+/* ── 组件类 ─────────────────────────────────────────── */
+.nk-title { font-size: 13px; font-weight: 600; color: var(--nk-muted); letter-spacing: 0.02em; margin: 0 0 6px; }
+.nk-stat { font-family: var(--nk-num-font); font-size: 30px; font-weight: 700; line-height: 1.1; font-variant-numeric: tabular-nums; }
+.nk-stat small { font-size: 14px; font-weight: 500; color: var(--nk-muted); margin-left: 3px; }
+.nk-label { font-size: 12px; color: var(--nk-faint); }
+.nk-accent { color: var(--nk-accent); }
+.nk-good { color: var(--nk-good); }
+.nk-bad { color: var(--nk-bad); }
+
+.nk-list { margin: 0; padding: 0; list-style: none; }
+.nk-row {
+  display: flex; align-items: center; justify-content: space-between;
+  gap: 10px; padding: 6px 0; border-bottom: 1px solid var(--nk-divider);
+  font-size: 13px;
+}
+.nk-row:last-child { border-bottom: 0; }
+.nk-row .nk-value { color: var(--nk-muted); font-variant-numeric: tabular-nums; }
+
+.nk-progress { height: 6px; border-radius: 999px; background: var(--nk-track); overflow: hidden; }
+.nk-progress > i { display: block; height: 100%; border-radius: inherit; background: var(--nk-accent); transition: width 0.4s var(--nk-ease); }
+
+.nk-badge {
+  display: inline-flex; align-items: center; gap: 5px;
+  font-size: 12px; color: var(--nk-muted);
