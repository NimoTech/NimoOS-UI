+    expect(w.findComponent({ name: 'WebUiHttpsDialog' }).props('open')).toBe(true)
+  })
+
+  it('弹窗 saved 后重新拉配置(对位 Vue2 modal close → getSSLConfig)', async () => {
+    state.ssl.enabled = true
