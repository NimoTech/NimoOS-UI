 const filePanelMap: Record<PanelType, string[]> = {
   'code-editor': union(TEXT_X_GENERIC, TEXT_CSS, TEXT_HTML, TEXT_X_CMAKE, TEXT_DOCKERFILE),
   'video-player': union(BROWSER_PLAYABLE_VIDEO, AUDIO_X_GENERIC),
