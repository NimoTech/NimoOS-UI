diff --git a/src/ai/markdown/renderMarkdown.test.ts b/src/ai/markdown/renderMarkdown.test.ts
new file mode 100644
index 0000000..684d2f3
--- /dev/null
+++ b/src/ai/markdown/renderMarkdown.test.ts
@@ -0,0 +1,27 @@
+import { describe, it, expect } from 'vitest'
+import { renderMarkdown } from './renderMarkdown'
+
+describe('renderMarkdown (AI Agent)', () => {
+  it('**b** → <strong>', () => {
+    expect(renderMarkdown('**b**')).toContain('<strong>b</strong>')
+  })
+
+  it('裸 URL 被 linkify 成 <a>', () => {
+    const html = renderMarkdown('see https://example.com for more')
+    expect(html).toContain('<a')
+    expect(html).toContain('href="https://example.com"')
+  })
+
+  it('XSS 回归:<script> 被清除,不产生存活的 script 标签', () => {
+    const html = renderMarkdown('<script>alert(1)</script>')
+    expect(html).not.toContain('<script>')
+    expect(html).not.toContain('</script>')
+  })
+
+  it('breaks:false 语义:单个换行不产生 <br>(与 Vue2 一致)', () => {
+    const html = renderMarkdown('line one\nline two')
+    expect(html).not.toContain('<br>')
+    expect(html).not.toContain('<br/>')
+    expect(html).not.toContain('<br />')
+  })
+})
diff --git a/src/ai/markdown/renderMarkdown.ts b/src/ai/markdown/renderMarkdown.ts
new file mode 100644
index 0000000..93e9c84
--- /dev/null
+++ b/src/ai/markdown/renderMarkdown.ts
@@ -0,0 +1,17 @@
+// 1:1 移植自 Vue2 src/views/AI/Agent/markdown/renderMarkdown.js
+import MarkdownIt from 'markdown-it'
+import DOMPurify from 'dompurify'
+
+const md = new MarkdownIt({
+  html: false,
+  linkify: true,
+  breaks: false,
+  typographer: false,
+})
+
+// Render markdown to sanitized HTML string. Used via v-html.
+export function renderMarkdown(src: string): string {
+  if (!src) return ''
+  const raw = md.render(src)
+  return DOMPurify.sanitize(raw, { ADD_ATTR: ['target'] })
+}
diff --git a/src/ai/styles/agent-styles.scss b/src/ai/styles/agent-styles.scss
new file mode 100644
index 0000000..a5c238a
--- /dev/null
+++ b/src/ai/styles/agent-styles.scss
@@ -0,0 +1,1318 @@
+// 1:1 移植自 Vue2 Agent;字面色值为作用域内既有体系,豁免全局 token 规则。
+// AI Agent page styles. All rules scoped under .agent-app to prevent
+// collision with the rest of NimoOS UI.
+// Source: design/ai_agent_design/styles.css.
+// Tokens (lines 1-90) are in tokens.scss; the element resets at lines 99-111
+// are reproduced inside .agent-app below so they don't leak to other pages.
+
+.agent-app {
+  // Aurora background (was on body in design, scoped here to avoid polluting other pages)
+  background: var(--bg-app);
+
+  // Layout grid (was .app in design)
+  display: grid;
+  grid-template-columns: 260px 1fr 360px;
+  height: 100vh;
+  width: 100vw;
+  overflow: hidden;
+  font-family: var(--font-sans);
+  color: var(--text-primary);
+
+  &[data-rightcollapsed="true"] { grid-template-columns: 260px 1fr 0; }
+  &[data-leftcollapsed="true"] { grid-template-columns: 64px 1fr 360px; }
+  &[data-leftcollapsed="true"][data-rightcollapsed="true"] { grid-template-columns: 64px 1fr 0; }
+
+  // ===== Element resets (scoped to .agent-app) =====
+  // Original design had a global `button { border: 0; ... }` reset at
+  // styles.css:110. Without it, browsers paint the default 2px button border
