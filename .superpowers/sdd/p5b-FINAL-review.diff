+})
+
+describe('basename', () => {
+  // 蓝本 QueueView.vue:398 的行为,照抄不改:
+  // `basename(p) { return p ? (...) : '—' }` —— 空值返回 U+2014 破折号 '—',
+  // 不是连字符 '-'。
+  it("empty/null/undefined return the em dash '—', not a hyphen — QueueView.vue:398, copied verbatim", () => {
+    expect(basename('')).toBe('—')
