+
+  it('hydrateTheme 优先读 localStorage', () => {
+    localStorage.setItem(KEY, 'dark')
+    const s = useAiTheme()
+    s.hydrateTheme()
+    expect(s.theme).toBe('dark')
+  })
+
+  it('hydrateTheme 忽略 localStorage 里的非法值,回落系统偏好', () => {
+    localStorage.setItem(KEY, 'chartreuse')
+    stubMatchMedia(true)
+    const s = useAiTheme()
+    s.hydrateTheme()
+    expect(s.theme).toBe('dark')
+  })
