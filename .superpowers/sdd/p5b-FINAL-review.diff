+  // 否则「去掉尾斜杠」这种回归（RED 探针 3）测不出来。
+  it("'/DATA'（无第二个斜杠）-> null；'/DATA/x'（有）-> 'DATA' — IndexedFilesView.vue:442-444, copied verbatim", () => {
