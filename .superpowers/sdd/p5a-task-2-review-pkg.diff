+    expect(await createWiki(http).getTree()).toEqual([])
+  })
+
+  it('getRaw 把非字符串 body 强制成字符串,null/undefined 成空串', async () => {
+    const mk = (v: unknown) => createWiki(recorder(() => v).http)
