+.mcc-btn.deny { background: transparent; color: var(--text-tertiary); margin-left: auto; }
+.mcc-btn.deny:hover { color: var(--danger); background: var(--danger-soft); }
+.mcc-err { font-size: 12px; color: var(--danger); width: 100%; }
