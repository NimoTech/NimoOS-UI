+    expect(baseName('/DATA/a/b.txt')).toBe('b.txt')
+    expect(baseName('/DATA/a/b/')).toBe('b')
+  })
+  it('never throws on empty input', () => {
+    expect(baseName('')).toBe('')
+  })
+})
