+import { describe, it, expect, vi, beforeEach } from 'vitest'
+
+const store = { blob: undefined as unknown, getCalls: 0, setCalls: [] as unknown[] }
+
+vi.mock('@nimotech/nimoos-service', () => ({
+  service: {
+    users: {
