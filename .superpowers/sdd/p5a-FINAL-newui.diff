+      >
+        <KIcon name="grid" :size="18" />
+        <span>{{ t('aiKbMore') }}</span>
+      </button>
+    </nav>
+
+    <!-- Toast: retired (K3) — global useToast() renders it via AppToast, not here. -->
+  </div>
+</template>
