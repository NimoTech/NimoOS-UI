 vi.mock('lottie-web', () => ({ default: { loadAnimation: vi.fn(() => ({ addEventListener: vi.fn(), destroy: vi.fn() })) } }))
 
+// Same problem, new source (T7): router/index.ts now also statically imports AppConsolePage.vue
